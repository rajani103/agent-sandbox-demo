# Copy to .env in this folder.

# Gemini via API key (or set GOOGLE_GENAI_USE_VERTEXAI=TRUE + project/location instead)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here
MODEL=gemini-2.5-flash

# Where code runs: docker (laptop, Docker Sandboxes) or gke (GKE Agent Sandbox)
SANDBOX_BACKEND=gke

# docker backend
DOCKER_SANDBOX=agent-runner

# gke backend
WARM_POOL=python-sandbox-pool
SANDBOX_NAMESPACE=agents
